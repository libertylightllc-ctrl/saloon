# Copy to .env and fill in. EXPO_PUBLIC_ values are bundled into the app, so only the
# public anon key goes here — never the service role key.
# Local: run `npx supabase start` and copy the API URL and anon key it prints.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
