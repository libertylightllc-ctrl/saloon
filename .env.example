# Copy to .env (git-ignored). EXPO_PUBLIC_ values are bundled into the app, so only public keys go here.

# Local database (npx supabase start): "auto" makes a phone use this Mac's network IP and the web
# preview use its own host, so nothing needs editing when the Wi-Fi IP changes.
EXPO_PUBLIC_SUPABASE_URL=auto
# The standard public key of every local Supabase — shown by `npx supabase status` as ANON_KEY.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Hosted project instead (supabase.com → Project Settings → API):
# EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon public key>
