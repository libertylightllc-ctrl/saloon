{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "node scripts/check-web-env.mjs && npx expo export -p web && node scripts/site/build.mjs",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/welcome",
      "missing": [
        {
          "type": "cookie",
          "key": "sq_in"
        }
      ],
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:lang(ar|hi|ur|es|fr|pt)/",
      "destination": "/:lang",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "missing": [
        {
          "type": "cookie",
          "key": "sq_in"
        }
      ],
      "destination": "/site/en.html"
    },
    {
      "source": "/:lang(ar|hi|ur|es|fr|pt)",
      "destination": "/site/:lang.html"
    },
    {
      "source": "/b/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Slackbot|TelegramBot|Discordbot|SkypeUriPreview|Pinterestbot|Snap URL Preview|redditbot|Embedly).*"
        }
      ],
      "destination": "/api/booking-preview?slug=:slug"
    },
    {
      "source": "/:page(contact|privacy|terms)",
      "destination": "/site/:page.html"
    },
    {
      "source": "/",
      "destination": "/spa.html"
    },
    {
      "source": "/:route(accounts|accounts-tab|accounts/close-period|admin|appointment/new|attendance|auth-callback|b/[^/]+|booking/[^/]+|cash-closing|cash-closing/[^/]+|compliance|compliance/doc|console|contact|customers|customers/[^/]+|dev/gallery|expenses|expenses/[^/]+|forgot-password|inventory|inventory/[^/]+|more|notifications|pay|payroll|payroll/adjustments|plan|privacy|profile|purchases|purchases/[^/]+|queue|r/[^/]+|reports|reports-tab|sale|sales|sales/[^/]+|services|services/categories|services/form|settings/backup|settings/branch|settings/team|setup|sign-in|sign-up|staff|staff/[^/]+|support|terms|welcome)",
      "destination": "/spa.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/_expo/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/site/(img|fonts)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
